# Configuración de Firebase (opcional). Sin estas variables, la app funciona
# en modo local (localStorage), sin sincronización entre usuarios ni login.
#
# Estos valores son públicos del lado del cliente — cópialos desde:
# Firebase Console → ⚙️ Configuración del proyecto → General → Tus apps → Web
#
# Para desarrollo local: copia este archivo a ".env" y completa los valores.
# Para producción en Vercel: agrégalos en Project Settings → Environment Variables.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
