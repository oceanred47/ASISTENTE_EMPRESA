# URL de conexión Postgres (ej. Supabase, Neon, Vercel Postgres)
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Contraseña para acceder al panel (elige una segura)
APP_PASSWORD="cambia-esto"

# Secreto para firmar la sesión de login (genera uno único, ej: openssl rand -hex 32)
AUTH_SECRET="genera-un-secreto-aleatorio"
